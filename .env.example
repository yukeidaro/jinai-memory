# Local-only example. Never commit real credentials or share token-bearing URLs.
# The server does not load this file automatically.
# Local use: copy to .env and run node --env-file=.env src/server.js (Node 24).
# Render: use the Blueprint and its Environment screen, not this file.

# Required shared secret: replace this dummy locally. Render generates its own value.
MEMORY_TOKEN=replace-with-a-long-random-token

# Optional multi-user JSON. When set, this overrides MEMORY_TOKEN and MEMORY_USER.
# Remove the variable entirely for legacy single-user mode; a blank value is invalid.
# User names: 1-40 letters, digits, underscores or hyphens. Unique tokens: 24+ characters.
# Dummy values only. Generate separate cryptographically random tokens before use.
# MEMORY_USERS={"demo":"demo-dummy-token-000000000000","yu":"yu-dummy-token-111111111111"}

# FalkorDB connection URL. Empty selects non-persistent in-memory storage locally.
# Render deployment requires your real URL, entered privately in the Dashboard.
# redis:// is unencrypted; use demo data only. Do not paste credentials here.
FALKORDB_URL=

# fake needs no API key; openai requires OPENAI_API_KEY.
# If omitted entirely, the server selects openai when a nonempty API key exists.
EMBEDDINGS_PROVIDER=fake

# Optional for fake; required for openai. Leave empty when using fake locally.
OPENAI_API_KEY=

# Positive integer, not blank. Defaults when omitted: fake=128, openai=1536.
# When switching to openai, change this to 1536 or remove this line.
# Existing FalkorDB vector indexes must have the same dimension.
EMBED_DIM=128

# Legacy graph namespace/user, ignored when MEMORY_USERS is set. Default: demo.
# Use letters, digits, colon, underscore or hyphen.
MEMORY_USER=demo

# Local default: 8787. Render supplies PORT; do not override it there.
PORT=8787

# Docker sets this automatically; it is not an application-required variable.
NODE_ENV=production
